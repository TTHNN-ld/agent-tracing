# Copy this file to langfuse/.env and fill values.
# This is the single source of truth for both agent plugins and the Collector.

# Langfuse URL used by agent plugins on the host.
LANGFUSE_BASE_URL=http://localhost:3000

# Langfuse URL reachable from the Collector container.
# macOS Docker Desktop: http://host.docker.internal:3000
# Linux Docker with host-gateway or external Langfuse: use a reachable URL.
LANGFUSE_OTEL_EXPORTER_BASE_URL=http://host.docker.internal:3000

LANGFUSE_PUBLIC_KEY_OPENCODE=pk-lf-...
LANGFUSE_SECRET_KEY_OPENCODE=sk-lf-...

LANGFUSE_PUBLIC_KEY_PI=pk-lf-...
LANGFUSE_SECRET_KEY_PI=sk-lf-...

LANGFUSE_PUBLIC_KEY_CLINE=pk-lf-...
LANGFUSE_SECRET_KEY_CLINE=sk-lf-...

LANGFUSE_PUBLIC_KEY_CLAUDECODE=pk-lf-...
LANGFUSE_SECRET_KEY_CLAUDECODE=sk-lf-...

LANGFUSE_PUBLIC_KEY_CODEX=pk-lf-...
LANGFUSE_SECRET_KEY_CODEX=sk-lf-...

# Optional metadata.
LANGFUSE_ENVIRONMENT=production
LANGFUSE_MAX_IO_CHARS=20000
LANGFUSE_OTEL_TIMEOUT_MS=200
